{%- comment -%}
  JP MART Black Friday banner v6 (dev theme 204665979144): server-side countdown values (no 0/0/0 flash, works without JS), broader brand copy.
  Phases: teaser -> live -> hidden (dates in settings). force_show = preview only.
  Offers in Shopify (30 Oct - 30 Nov 2026, once per customer, no combining): BF2026 = 10% on 3 Vatika bundles; BF3 = 10% when buying 3+ items from the Dabur collection (incl. Vatika).
{%- endcomment -%}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign teaser_ts = section.settings.teaser_start | date: '%s' | plus: 0
  assign start_ts = section.settings.start | date: '%s' | plus: 0
  assign end_ts = section.settings.end | date: '%s' | plus: 0
  assign phase = ''
  if section.settings.force_show or request.design_mode
    assign phase = 'live'
    assign end_for_js = end_ts
  elsif now_ts >= start_ts and now_ts <= end_ts
    assign phase = 'live'
    assign end_for_js = end_ts
  elsif now_ts >= teaser_ts and now_ts < start_ts
    assign phase = 'teaser'
    assign end_for_js = start_ts
  endif
  assign remaining = end_for_js | minus: now_ts
  if remaining < 0
    assign remaining = 0
  endif
  assign cd_d = remaining | divided_by: 86400
  assign cd_h = remaining | modulo: 86400 | divided_by: 3600
  assign cd_m = remaining | modulo: 3600 | divided_by: 60
  assign loc = request.locale.iso_code
  assign bf_url = routes.root_url | append: '/collections/black-friday' | replace: '//', '/'
  assign all_url = routes.root_url | append: '/collections/all' | replace: '//', '/'
-%}
{%- if phase != '' -%}
<section class="jp-bf" data-phase="{{ phase }}" aria-label="Black Friday">
  <span class="jp-bf__leaf jp-bf__leaf--a" aria-hidden="true">🍂</span>
  <span class="jp-bf__leaf jp-bf__leaf--b" aria-hidden="true">🍁</span>
  <span class="jp-bf__leaf jp-bf__leaf--c" aria-hidden="true">🍂</span>
  <div class="jp-bf__inner">
    <svg class="jp-bf__pumpkin" viewBox="0 0 120 100" width="96" height="80" aria-hidden="true" focusable="false">
      <path d="M60 22c-3-9 1-15 9-18" fill="none" stroke="#6b8e3d" stroke-width="6" stroke-linecap="round"/>
      <path d="M66 18c10-8 22-4 24 4-8 2-16 0-24-4z" fill="#6b8e3d"/>
      <ellipse cx="32" cy="60" rx="24" ry="34" fill="#d9731a"/>
      <ellipse cx="88" cy="60" rx="24" ry="34" fill="#d9731a"/>
      <ellipse cx="46" cy="60" rx="22" ry="37" fill="#f08a24"/>
      <ellipse cx="74" cy="60" rx="22" ry="37" fill="#f08a24"/>
      <ellipse cx="60" cy="60" rx="17" ry="39" fill="#ffa23a"/>
    </svg>
    <p class="jp-bf__eyebrow">
      {%- case loc -%}{%- when 'en' -%}Black Friday · until 30.11{%- when 'de' -%}Black Friday · bis 30.11{%- else -%}Black Friday · do 30.11{%- endcase -%}
    </p>
    <h2 class="jp-bf__title">
      {%- if phase == 'teaser' -%}
        {%- case loc -%}
          {%- when 'en' -%}Black Friday is almost here
          {%- when 'de' -%}Black Friday ist fast da
          {%- else -%}Black Friday tuż, tuż
        {%- endcase -%}
      {%- else -%}
        {%- case loc -%}
          {%- when 'en' -%}Black Friday at JP MART
          {%- when 'de' -%}Black Friday bei JP MART
          {%- else -%}Black Friday w JP MART
        {%- endcase -%}
      {%- endif -%}
    </h2>
    <p class="jp-bf__sub">
      {%- case loc -%}
        {%- when 'en' -%}Original Indian cosmetics, teas and groceries – shipped from Poland.
        {%- when 'de' -%}Originale indische Kosmetik, Tees und Lebensmittel – Versand aus Polen.
        {%- else -%}Oryginalne indyjskie kosmetyki, herbaty i żywność – wysyłka z Polski.
      {%- endcase -%}
    </p>
    {%- if section.settings.code != blank -%}
      <div class="jp-bf__deals">
        <div class="jp-bf__deal">
          <p class="jp-bf__offer">
            {%- case loc -%}
              {%- when 'en' -%}Extra 10% off Vatika hair bundles
              {%- when 'de' -%}Extra 10 % auf Vatika-Haarsets
              {%- else -%}Extra 10% na zestawy do włosów Vatika
            {%- endcase -%}
          </p>
          <p class="jp-bf__code">
            {%- case loc -%}{%- when 'en' -%}Code{%- when 'de' -%}Code{%- else -%}Kod{%- endcase %} <strong>{{ section.settings.code | escape }}</strong>
          </p>
        </div>
        {%- if section.settings.code2 != blank -%}
          <div class="jp-bf__deal">
            <p class="jp-bf__offer">
              {%- case loc -%}
                {%- when 'en' -%}Buy 3+ Dabur or Vatika items: 10% off
                {%- when 'de' -%}3+ Dabur- oder Vatika-Artikel: 10 % Rabatt
                {%- else -%}3+ produkty Dabur lub Vatika: -10%
              {%- endcase -%}
            </p>
            <p class="jp-bf__code">
              {%- case loc -%}{%- when 'en' -%}Code{%- when 'de' -%}Code{%- else -%}Kod{%- endcase %} <strong>{{ section.settings.code2 | escape }}</strong>
            </p>
          </div>
        {%- endif -%}
      </div>
      <p class="jp-bf__note">
        {%- case loc -%}
          {%- when 'en' -%}Valid until 30 Nov, once per customer, codes cannot be combined.
          {%- when 'de' -%}Gültig bis 30.11., einmal pro Kunde, Codes nicht kombinierbar.
          {%- else -%}Ważne do 30.11, raz na klienta, kody się nie łączą.
        {%- endcase -%}
      </p>
    {%- endif -%}
    <ul class="jp-bf__cards">
      <li><span aria-hidden="true">🎁</span>
        {%- case loc -%}{%- when 'en' -%}Bundles cost less than buying separately{%- when 'de' -%}Sets sind günstiger als Einzelkauf{%- else -%}Zestawy taniej niż osobno{%- endcase -%}
      </li>
      <li><span aria-hidden="true">🚚</span>
        {%- case loc -%}{%- when 'en' -%}Free delivery in Poland from 99 zł{%- when 'de' -%}Gratis-Lieferung in Polen ab 99 zł{%- else -%}Darmowa dostawa od 99 zł{%- endcase -%}
      </li>
      <li><span aria-hidden="true">🌿</span>
        {%- case loc -%}{%- when 'en' -%}Original products, shipped from Poland{%- when 'de' -%}Originalprodukte, Versand aus Polen{%- else -%}Oryginalne produkty, wysyłka z Polski{%- endcase -%}
      </li>
    </ul>
    <div class="jp-bf__count" data-jp-bf-end="{{ end_for_js }}" {% if remaining <= 0 %}hidden{% endif %}>
      <span><b data-u="d">{{ cd_d }}</b><i>{% if loc == 'en' %}days{% elsif loc == 'de' %}Tage{% else %}dni{% endif %}</i></span>
      <span><b data-u="h">{{ cd_h }}</b><i>{% if loc == 'en' %}hrs{% elsif loc == 'de' %}Std{% else %}godz.{% endif %}</i></span>
      <span><b data-u="m">{{ cd_m }}</b><i>min</i></span>
    </div>
    <div class="jp-bf__cta">
      <a class="jp-bf__btn" href="{{ bf_url }}">
        {%- case loc -%}{%- when 'en' -%}See Black Friday bundles{%- when 'de' -%}Black-Friday-Sets ansehen{%- else -%}Zobacz zestawy Black Friday{%- endcase -%}
      </a>
      <a class="jp-bf__link" href="{{ all_url }}">
        {%- case loc -%}{%- when 'en' -%}All products →{%- when 'de' -%}Alle Produkte →{%- else -%}Wszystkie produkty →{%- endcase -%}
      </a>
    </div>
  </div>
</section>
<script>
  (function () {
    var el = document.querySelector('.jp-bf__count[data-jp-bf-end]');
    if (!el) return;
    var end = parseInt(el.getAttribute('data-jp-bf-end'), 10) * 1000;
    if (!end) return;
    function tick() {
      var s = Math.max(0, Math.floor((end - Date.now()) / 1000));
      if (s <= 0) { el.hidden = true; return; }
      el.hidden = false;
      el.querySelector('[data-u="d"]').textContent = Math.floor(s / 86400);
      el.querySelector('[data-u="h"]').textContent = Math.floor((s % 86400) / 3600);
      el.querySelector('[data-u="m"]').textContent = Math.floor((s % 3600) / 60);
    }
    tick();
    setInterval(tick, 30000);
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .jp-bf { position: relative; overflow: hidden; background: radial-gradient(120% 140% at 50% 0%, #3a1d0b 0%, #1a110a 55%, #111815 100%); color: #fbf8f2; padding: 32px 16px 28px; text-align: center; border-bottom: 3px solid #f08a24; }
  .jp-bf__inner { position: relative; z-index: 1; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .jp-bf__pumpkin { filter: drop-shadow(0 6px 14px rgba(240,138,36,.35)); }
  .jp-bf__eyebrow { margin: 0; font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; color: #ffa23a; font-weight: 700; }
  .jp-bf__title { margin: 0; font-size: clamp(1.8rem, 1.2rem + 2.6vw, 2.8rem); color: #fff; text-wrap: balance; }
  .jp-bf__sub { margin: 0; max-width: 52ch; color: #f0e4d2; line-height: 1.5; }
  .jp-bf__deals { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; width: 100%; margin-top: 4px; }
  .jp-bf__deal { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 12px; border-radius: 14px; background: rgba(240,138,36,.12); border: 1px solid rgba(255,162,58,.5); }
  .jp-bf__offer { margin: 0; font-weight: 800; font-size: 1.05rem; color: #ffa23a; }
  .jp-bf__code { margin: 0; padding: 6px 16px; border: 2px dashed #ffa23a; border-radius: 12px; color: #fff; }
  .jp-bf__code strong { letter-spacing: .1em; color: #ffa23a; }
  .jp-bf__note { margin: 0; font-size: .85rem; color: #d8c8b0; }
  .jp-bf__cards { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; width: 100%; }
  .jp-bf__cards li { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 10px; border-radius: 14px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,162,58,.28); font-weight: 600; line-height: 1.3; }
  .jp-bf__cards li span { font-size: 1.5rem; }
  .jp-bf__count { display: flex; gap: 12px; margin-top: 4px; }
  .jp-bf__count[hidden] { display: none; }
  .jp-bf__count span { display: flex; flex-direction: column; align-items: center; min-width: 58px; padding: 8px 6px; border-radius: 12px; background: #f08a24; color: #1a110a; }
  .jp-bf__count b { font-size: 1.5rem; line-height: 1.1; }
  .jp-bf__count i { font-style: normal; font-size: .72rem; font-weight: 700; }
  .jp-bf__cta { display: flex; flex-wrap: wrap; gap: 12px 20px; justify-content: center; align-items: center; margin-top: 8px; }
  .jp-bf__btn { display: inline-flex; align-items: center; min-height: 50px; padding: 0 28px; border-radius: 12px; background: #f08a24; color: #1a110a; font-weight: 800; text-decoration: none; box-shadow: 0 8px 22px -10px rgba(240,138,36,.8); }
  .jp-bf__btn:hover { background: #ffa23a; }
  .jp-bf__link { color: #fbf8f2; text-underline-offset: 3px; }
  .jp-bf__leaf { position: absolute; font-size: 1.6rem; opacity: .55; pointer-events: none; }
  .jp-bf__leaf--a { top: 12%; left: 6%; transform: rotate(-20deg); }
  .jp-bf__leaf--b { top: 58%; right: 7%; transform: rotate(18deg); }
  .jp-bf__leaf--c { bottom: 8%; left: 14%; transform: rotate(40deg); }
  @media (prefers-reduced-motion: no-preference) {
    .jp-bf__pumpkin { animation: jp-bf-bob 3.6s ease-in-out infinite; }
    .jp-bf__leaf--a { animation: jp-bf-sway 6s ease-in-out infinite; }
    .jp-bf__leaf--b { animation: jp-bf-sway 7s ease-in-out infinite reverse; }
  }
  @keyframes jp-bf-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes jp-bf-sway { 0%,100% { transform: rotate(-20deg) translateY(0); } 50% { transform: rotate(10deg) translateY(8px); } }
  @media (max-width: 749px) {
    .jp-bf { padding: 24px 14px 22px; }
    .jp-bf__deals, .jp-bf__cards { grid-template-columns: 1fr; }
    .jp-bf__cards li { flex-direction: row; justify-content: center; text-align: left; padding: 10px 12px; }
    .jp-bf__btn { width: 100%; justify-content: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JP MART Black Friday",
  "settings": [
    { "type": "header", "content": "Schedule (CET = +0100)" },
    { "type": "text", "id": "teaser_start", "label": "Teaser starts", "default": "2026-10-30 00:00:00 +0100" },
    { "type": "text", "id": "start", "label": "Sale starts", "default": "2026-10-30 00:00:00 +0100" },
    { "type": "text", "id": "end", "label": "Sale ends", "default": "2026-11-30 23:59:00 +0100" },
    { "type": "checkbox", "id": "force_show", "label": "Preview: show live phase now", "default": false },
    { "type": "header", "content": "Offers" },
    { "type": "text", "id": "code", "label": "Bundle code (empty = no offers)", "default": "BF2026" },
    { "type": "text", "id": "code2", "label": "3+ items code (optional)", "default": "BF3" }
  ],
  "presets": []
}
{% endschema %}
