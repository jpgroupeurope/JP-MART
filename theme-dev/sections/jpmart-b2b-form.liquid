{%- comment -%}
  JP MART B2B account application (public lead capture). Extended dev version of the v10 section.
  Native Shopify contact form: email notification + customer record tagged lead-new (pipeline tags: lead-new > lead-verified > lead-approved > lead-quotation > lead-paid).
  Tags set here NEVER grant wholesale access. No prices rendered. Add a language: add a when-branch below.
{%- endcomment -%}
{%- case request.locale.iso_code -%}
  {%- when 'en' -%}
    {%- assign t = 'Wholesale application|Contact person|Business email|Phone|Company name|VAT ID (EU VAT number)|Country|Company address|Type of business|Shop|Pharmacy|Beauty salon / spa|Yoga / Ayurveda studio|Restaurant|Distributor / wholesaler|Other|Message (optional)|I confirm that I am applying on behalf of a registered company.|Send application|Thank you! We have received your application. We will verify your company and contact you – usually within 1 business day.|Fields marked * are required.|Company website|Brands of interest|Estimated order size (e.g. cartons per month)|Select country|I have read the|privacy policy|and agree that JP MART may contact me about this enquiry.' | split: '|' -%}
  {%- when 'de' -%}
    {%- assign t = 'Großhandelsantrag|Ansprechpartner|Geschäftliche E-Mail|Telefon|Firmenname|USt-IdNr. (EU)|Land|Firmenadresse|Art des Unternehmens|Geschäft|Apotheke|Kosmetiksalon / Spa|Yoga- / Ayurveda-Studio|Restaurant|Distributor / Großhändler|Sonstiges|Nachricht (optional)|Ich bestätige, dass ich im Namen eines eingetragenen Unternehmens anfrage.|Antrag senden|Vielen Dank! Wir haben Ihren Antrag erhalten. Wir prüfen Ihr Unternehmen und melden uns – in der Regel innerhalb von 1 Werktag.|Mit * markierte Felder sind Pflichtfelder.|Website des Unternehmens|Marken von Interesse|Geschätzte Bestellmenge (z. B. Kartons pro Monat)|Land auswählen|Ich habe die|Datenschutzerklärung|gelesen und bin damit einverstanden, dass JP MART mich zu dieser Anfrage kontaktiert.' | split: '|' -%}
  {%- else -%}
    {%- assign t = 'Formularz zgłoszeniowy B2B|Osoba kontaktowa|Służbowy e-mail|Telefon|Nazwa firmy|Numer VAT UE (NIP z prefiksem kraju)|Kraj|Adres firmy|Rodzaj działalności|Sklep|Apteka|Salon beauty / spa|Studio jogi / ajurwedy|Restauracja|Dystrybutor / hurtownia|Inne|Wiadomość (opcjonalnie)|Potwierdzam, że składam zgłoszenie w imieniu zarejestrowanej firmy.|Wyślij zgłoszenie|Dziękujemy! Otrzymaliśmy Twoje zgłoszenie. Zweryfikujemy firmę i skontaktujemy się – zwykle w ciągu 1 dnia roboczego.|Pola oznaczone * są wymagane.|Strona internetowa firmy|Interesujące marki|Szacowana wielkość zamówienia (np. kartony miesięcznie)|Wybierz kraj|Przeczytałem/am|politykę prywatności|i zgadzam się, aby JP MART skontaktował się ze mną w sprawie tego zapytania.' | split: '|' -%}
{%- endcase -%}
{%- assign countries = 'Austria|Belgium|Bulgaria|Croatia|Cyprus|Czechia|Denmark|Estonia|Finland|France|Germany|Greece|Hungary|Ireland|Italy|Latvia|Lithuania|Luxembourg|Malta|Netherlands|Poland|Portugal|Romania|Slovakia|Slovenia|Spain|Sweden' | split: '|' -%}
{%- assign brands = 'Dabur|Vatika|Himalaya|Sesa|Vicco|Organic India|Indian grocery|Other' | split: '|' -%}

{{ 'jpmart-b2b.css' | asset_url | stylesheet_tag }}
<div class="jpb2b" id="b2b-form">
  <h2 class="jpb2b__title">{{ t[0] }}</h2>
  <p class="jpb2b__ok" id="jpb2b-ok" role="status" hidden>✅ {{ t[19] }}</p>
  {%- assign rt_apply = request.path | append: '?sent=apply#b2b-form' -%}
  {%- form 'contact', id: 'jpm-b2b-contact', class: 'jpb2b__form', return_to: rt_apply -%}
    {%- if form.errors -%}<div class="jpb2b__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div id="jpb2b-fields">
      <input type="hidden" name="contact[Typ zgłoszenia]" value="HURT B2B – nowe konto">
      <input type="hidden" name="contact[tags]" value="lead-new, account-application, lead-lang-{{ request.locale.iso_code }}">
      <input type="hidden" name="contact[Język strony]" value="{{ request.locale.iso_code }}">
      <input type="hidden" name="contact[Pipeline]" value="New Inquiry">
      <input type="hidden" name="contact[UTM]" id="jpb2b-utm" value="">
      <input type="hidden" name="contact[Landing / referrer]" id="jpb2b-ref" value="">
      <div class="jpb2b__hp" aria-hidden="true"><label>Website2<input type="text" name="contact[Pole kontrolne]" tabindex="-1" autocomplete="off"></label></div>
      <div class="jpb2b__grid">
          <label>{{ t[1] }} *<input type="text" name="contact[name]" required autocomplete="name"></label>
          <label>{{ t[2] }} *<input type="email" name="contact[email]" required autocomplete="email"></label>
          <label>{{ t[3] }} *<input type="tel" name="contact[phone]" required autocomplete="tel"></label>
          <label>{{ t[4] }} *<input type="text" name="contact[Firma]" required autocomplete="organization"></label>
          <label>{{ t[5] }} *<input type="text" name="contact[NIP / VAT UE]" required placeholder="DE123456789"></label>
          <label>{{ t[6] }} *
            <select name="contact[Kraj]" required>
              <option value="">{{ t[24] }}</option>
              {%- for c in countries -%}<option>{{ c }}</option>{%- endfor -%}
            </select>
          </label>
          <label>{{ t[21] }}<input type="url" name="contact[Strona www]" placeholder="https://" autocomplete="url"></label>
          <label>{{ t[7] }} *<input type="text" name="contact[Adres firmy]" required autocomplete="street-address"></label>
          <label class="jpb2b__full">{{ t[8] }} *
            <select name="contact[Rodzaj działalności]" required>
              <option value="">—</option>
              {%- for i in (9..15) -%}<option>{{ t[i] }}</option>{%- endfor -%}
            </select>
          </label>
          <fieldset class="jpb2b__full jpb2b__brands">
            <legend>{{ t[22] }}</legend>
            {%- for b in brands -%}
              <label class="jpb2b__chip"><input type="checkbox" name="contact[Marki: {{ b }}]" value="TAK"> {{ b }}</label>
            {%- endfor -%}
          </fieldset>
          <label class="jpb2b__full">{{ t[23] }}<input type="text" name="contact[Szacowana ilość]"></label>
          <label class="jpb2b__full">{{ t[16] }}<textarea name="contact[body]" rows="4"></textarea></label>
          <label class="jpb2b__check jpb2b__full"><input type="checkbox" name="contact[Potwierdzenie firmy]" value="TAK" required> {{ t[17] }} *</label>
          <label class="jpb2b__check jpb2b__full"><input type="checkbox" name="contact[Zgoda RODO]" value="TAK" required> <span>{{ t[25] }} <a href="{{ routes.privacy_policy_url }}" target="_blank" rel="noopener">{{ t[26] }}</a> {{ t[27] }} *</span></label>
        </div>
        <p class="jpb2b__note">{{ t[20] }}</p>
        <button type="submit" class="jpb2b__btn">{{ t[18] }}</button>
    </div>
  {%- endform -%}
</div>
<script>
  (function () {
    try {
      var p = new URLSearchParams(location.search), u = [];
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'].forEach(function (k) { if (p.get(k)) u.push(k + '=' + p.get(k)); });
      if (u.length) sessionStorage.setItem('jpb2b_utm', u.join('&'));
      if (!sessionStorage.getItem('jpb2b_ref')) sessionStorage.setItem('jpb2b_ref', (document.referrer || 'direct') + ' | ' + location.pathname);
      document.getElementById('jpb2b-utm').value = sessionStorage.getItem('jpb2b_utm') || '';
      document.getElementById('jpb2b-ref').value = sessionStorage.getItem('jpb2b_ref') || '';
      if (p.get('sent') === 'apply') {
        document.getElementById('jpb2b-ok').hidden = false; document.getElementById('jpb2b-fields').hidden = true;
        if (window.gtag) gtag('event', 'generate_lead', { event_category: 'wholesale_apply' });
        if (window.fbq) fbq('track', 'Lead');
        if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('wholesale_apply_submitted', {});
      }
    } catch (e) {}
  })();
</script>

{% schema %}
{ "name": "JP MART – formularz B2B", "settings": [], "presets": [{ "name": "JP MART – formularz B2B" }] }
{% endschema %}
